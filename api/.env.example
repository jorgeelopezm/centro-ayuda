# Copiar a `.env` y rellenar con valores reales. `.env` está ignorado por git.

# Cadena de conexión a PostgreSQL (coincide con docker-compose.yml).
# Usar 127.0.0.1, no localhost: el contenedor publica solo en IPv4 y en Windows
# `localhost` intenta primero ::1, lo que cuelga la conexión unos dos minutos.
DATABASE_URL=postgresql+psycopg://helpcenter:helpcenter@127.0.0.1:5432/helpcenter

# Secreto para firmar los JWT. OBLIGATORIO: sin él la API no arranca.
# Generar uno propio:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Administrador inicial que crea el seed. Se crea como Root (nivel 3). La
# contraseña es OBLIGATORIA y se deja vacía a propósito: un valor de ejemplo acaba
# llegando a producción sin cambiar. Generarla igual que el secreto.
ADMIN_EMAIL=admin@centro-ayuda.local
ADMIN_PASSWORD=

# SuperAdmin inicial (nivel 4, transversal: gestiona los portales). OPCIONAL: si
# SUPERADMIN_PASSWORD queda vacío, el seed no crea el SuperAdmin ni el portal de
# plataforma (el entorno single-portal sigue funcionando). Para provisionarlo, poner
# una contraseña fuerte generada igual que las anteriores.
SUPERADMIN_EMAIL=superadmin@centro-ayuda.local
SUPERADMIN_PASSWORD=

# Valor inicial del campo [Empresa] (nombre de marca que ve el centro de ayuda).
# Editable después desde el panel por un usuario Root.
EMPRESA_INICIAL=[Empresa]

# Dominio base de los subdominios de portal (`<slug>.BASE_DOMAIN`). En DESARROLLO
# usar `localhost`: Chrome/Firefox resuelven cualquier `*.localhost` a 127.0.0.1
# sin tocar hosts ni DNS, así que un portal `aviacion` queda servible en
# `aviacion.localhost:3000`. En PRODUCCIÓN fijar el dominio real de la plataforma
# (p. ej. `BASE_DOMAIN=tuapp.com`); con el default de `config.py` (`tuapp.com`)
# los subdominios sembrados en desarrollo no resuelven en el navegador.
BASE_DOMAIN=localhost

# Clave de cifrado (Fernet) para las claves de API de los proveedores de IA que
# guarda Root desde el panel. Las claves de proveedor se guardan CIFRADAS con esta
# clave; nunca en claro. Se deja vacía a propósito. Generar una propia:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotarla obliga a que Root vuelva a introducir las claves de proveedor.
CLAVE_CIFRADO_IA=

# --- Chat con RAG por portal --------------------------------------------------
# Todas las variables tienen valor por defecto en `config.py`; solo hace falta
# ponerlas aquí si se quiere sobreescribir el defecto para un entorno concreto.

# Similitud coseno mínima que un fragmento debe superar para considerarse
# relevante (0-1). Ajustado para `voyage-3` (1024 dims); si se cambia el modelo
# de embeddings, revisar este umbral. Por debajo el chat devuelve `sin_resultados`.
RAG_UMBRAL_SIMILITUD=0.28

# Cota superior de fragmentos que el recuperador entrega al pipeline del chat.
RAG_TOP_K=6

# Cotas de la entrada al pipeline del chat: consultas más largas que
# CHAT_MAX_CONSULTA_CHARS caracteres se rechazan antes de tocar al proveedor;
# solo los últimos CHAT_MAX_HISTORIAL_TURNOS se pasan como historial.
CHAT_MAX_CONSULTA_CHARS=500
CHAT_MAX_HISTORIAL_TURNOS=10

# Nº de `sin_resultados` consecutivos por sesión tras el que se ofrece escalar
# a soporte con `razon: tope_turnos`.
CHAT_UMBRAL_TURNOS_SIN_RESULTADOS=2

# Vida útil de una sesión de chat en memoria del proceso (segundos). Vencida,
# se emite un `session_id` nuevo y el contador arranca en cero.
CHAT_TTL_SESION_SEG=1800

# Techo de peticiones por IP y minuto al endpoint público del chat. Superarlo
# devuelve error de límite sin invocar al proveedor de chat ni de embeddings.
CHAT_LIMITE_TASA_MIN=30

# Interruptor de mantenimiento del chat. `false` responde 503 con un mensaje de
# mantenimiento sin invocar al proveedor.
CHAT_HABILITADO=true

# --- Proxies confiables (X-Forwarded-*) --------------------------------------
# Lista separada por comas de IPs del salto inmediato ante el backend cuyas
# cabeceras `X-Forwarded-For` (IP del cliente) y `X-Forwarded-Host` (portal) se
# aceptan como fuente autoritativa. Cualquier IP que no esté aquí ve ignoradas
# esas cabeceras: sin la allow-list, un cliente que llegue directo al puerto
# del backend podría suplantar el portal o saltarse el rate limit fabricando
# cabeceras. Default (`127.0.0.1,::1`) sirve para desarrollo (Next → uvicorn en
# la misma máquina). En producción, poner aquí la IP del reverse proxy real
# (nginx/traefik/etc.) y NADA más.
PROXIES_CONFIABLES=127.0.0.1,::1
